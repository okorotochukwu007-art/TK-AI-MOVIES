# GEMINI_API_KEY: Required for Gemini AI movie classification, synopsis curation, and series parsing.
# Automatically injected at runtime by Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Connect your Supabase PostgreSQL project for persistent storage and Auth.
# Obtain these from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 keyword search and batch video statistics.
# Obtain from Google Cloud Console -> APIs & Services -> Enable YouTube Data API v3 -> Credentials.
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# CRON_SECRET: Optional secret token to authenticate external scheduled pings to POST /api/cron/discover
CRON_SECRET="your-cron-webhook-secret"

# RESEND_API_KEY: Optional API key from https://resend.com to dispatch branded HTML Welcome Emails on user signup alongside Supabase Auth confirmation emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TK STORYWORLD <onboarding@resend.dev>"
